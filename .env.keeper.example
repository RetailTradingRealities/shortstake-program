# ShortStake liquidation keeper - copy to .env.keeper on the VPS (chmod 600) and fill in.
# `npm run keeper` loads it automatically. Mainnet only (Jupiter + Jupiter Lend flash loans).

# --- Required ---------------------------------------------------------------
# A paid MAINNET RPC. Public mainnet RPC rate-limits getProgramAccounts. Use a key made for the
# keeper alone - never the web app's VITE_SOLANA_RPC_URL key, which Vite ships to every browser.
# Alchemy (verified: getProgramAccounts with filters + WebSocket subscriptions work):
KEEPER_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEEPER_KEY
# Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional: defaults to KEEPER_RPC_URL with http -> ws (right for Alchemy and Helius).
# KEEPER_WS_URL=wss://solana-mainnet.g.alchemy.com/v2/YOUR_KEEPER_KEY

# The keeper's OWN wallet (a fresh keypair - never the admin/deployer key). It pays fees,
# ATA rent and lookup-table rent, and receives liquidation profits in USDC.
KEEPER_KEYPAIR=/home/keeper/keeper-keypair.json

# Supabase publishable (anon) key - used to request signed prices from the price-oracle function.
SUPABASE_ANON_KEY=

# --- Recommended ------------------------------------------------------------
# Jupiter Developer Portal Server API key (Swap scope). Keyless works but is limited to 0.5 RPS.
JUPITER_API_KEY=

# --- Tuning (defaults shown) ------------------------------------------------
# Seconds between scans.
# KEEPER_POLL_SECONDS=15
# Skip buybacks expected to earn less than this (USDC, after swap cost and flash fee).
# KEEPER_MIN_PROFIT_USDC=0.05
# KEEPER_SLIPPAGE_BPS=100
# Priority fee (micro-lamports per CU). Raise it if liquidations land late on a busy network.
# KEEPER_PRIORITY_FEE_MICROLAMPORTS=
# KEEPER_MAX_PER_CYCLE=5
# Build + simulate only, never send ANYTHING (no lookup-table extends, no account creation).
# Use for the first run on a new VPS.
# KEEPER_DRY_RUN=false
# Refuse a liquidation when the signed price is more than this above Jupiter's market price
# (bps; protects borrowers from a pumped pool, Slot Zero M-01).
# KEEPER_MAX_PRICE_DEVIATION_BPS=1000

# --- High availability --------------------------------------------------------
# 0 = primary. On a BACKUP instance (other VPS, own wallet) set e.g. 30: it only acts on a
# position that has stayed liquidatable that long, i.e. when the primary isn't handling it.
# KEEPER_STANDBY_DELAY_SECONDS=0

# --- Advanced -----------------------------------------------------------------
# PRICE_ORACLE_URL=https://euwmdcepgwcesoqntlnd.supabase.co/functions/v1/price-oracle
# The lookup table is created on first start and remembered in KEEPER_STATE_FILE.
# KEEPER_STATE_FILE=keeper-state.json
# KEEPER_LOOKUP_TABLE=
