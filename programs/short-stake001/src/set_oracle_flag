use anchor_lang::prelude::*;
use crate::pyth_feeds_list::{OracleFlag, PYTH_ALLOWED_FEEDS};

pub fn is_pyth_supported(token_mint: Pubkey) -> OracleFlag {
    for (mint, _pyth_feed) in PYTH_ALLOWED_FEEDS.iter() {
        if *mint == token_mint {
            return OracleFlag::Pyth;
        }
    }
    OracleFlag::Custom
}




